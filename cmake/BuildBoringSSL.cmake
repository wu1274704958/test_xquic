# Run from a configured compiler environment:
# cmake -DMQAS_BORINGSSL_WORK_DIR=<absolute path> -P cmake/BuildBoringSSL.cmake
# The generated installation is <work dir>/install. Existing source trees
# with a different revision or local changes are never modified.
if(NOT DEFINED MQAS_BORINGSSL_WORK_DIR OR NOT IS_ABSOLUTE "${MQAS_BORINGSSL_WORK_DIR}")
    message(FATAL_ERROR "Set MQAS_BORINGSSL_WORK_DIR to an absolute, dedicated build directory")
endif()
set(_revision 0131ae9d78e42fcc2c1811315e62410ad96d8230)
set(_source "${MQAS_BORINGSSL_WORK_DIR}/source")
set(_build "${MQAS_BORINGSSL_WORK_DIR}/build")
set(_install "${MQAS_BORINGSSL_WORK_DIR}/install")
find_program(_git git REQUIRED)
function(_run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE _result COMMAND_ECHO STDOUT)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Command failed (${_result}): ${ARGV}")
    endif()
endfunction()
if(NOT EXISTS "${_source}/.git")
    if(EXISTS "${_source}")
        message(FATAL_ERROR "${_source} exists and is not a Git checkout")
    endif()
    file(MAKE_DIRECTORY "${MQAS_BORINGSSL_WORK_DIR}")
    _run("${_git}" init "${_source}")
    _run("${_git}" -C "${_source}" remote add origin https://boringssl.googlesource.com/boringssl)
    _run("${_git}" -C "${_source}" fetch --depth 1 origin "${_revision}")
    _run("${_git}" -C "${_source}" checkout --detach "${_revision}")
else()
    execute_process(COMMAND "${_git}" -C "${_source}" rev-parse HEAD OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _head_result)
    execute_process(COMMAND "${_git}" -C "${_source}" status --porcelain OUTPUT_VARIABLE _status RESULT_VARIABLE _status_result)
    if(NOT _head_result EQUAL 0 OR NOT _status_result EQUAL 0 OR NOT _head STREQUAL _revision OR NOT _status STREQUAL "")
        message(FATAL_ERROR "Existing BoringSSL source must be clean and at ${_revision}: ${_source}")
    endif()
endif()
_run("${CMAKE_COMMAND}" -S "${_source}" -B "${_build}" -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF "-DCMAKE_INSTALL_PREFIX=${_install}")
_run("${CMAKE_COMMAND}" --build "${_build}" --target ssl crypto bssl --parallel)
_run("${CMAKE_COMMAND}" --install "${_build}")
message(STATUS "BoringSSL installed at ${_install}; configure mqas with -DSSL_PATH=${_install}")
